# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional settings. Uncomment a line to change its default.

# Chat model used for answers, follow-up rewriting and query expansion
# OPENAI_MODEL=gpt-6-luna

# Set to true on your machine to turn off the chat UI's usage limits (leave unset when deployed)
# IS_LOCAL=true

# Usage limits for the Streamlit chat UI, to cap API spend on a public demo
# MAX_QUESTIONS_PER_SESSION=20
# MAX_QUESTIONS_PER_DAY=300
